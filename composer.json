{
    "name": "silvershop/shipping-myparcel",
    "description": "MyParcel shipping-label provider for silvershop/shipping-labels — creates carrier labels (PostNL; carrier-extensible) with tracking, from an order.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "shipping", "label", "myparcel", "postnl", "carrier"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-shipping-myparcel/graphs/contributors"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/RVXD/silvershop-shipping-labels.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/siteconfig": "^6.0",
        "silvershop/core": "^6",
        "silvershop/shipping-labels": "@dev",
        "myparcelnl/sdk": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4"
    },
    "suggest": {
        "silvershop/shipping": "Derives the parcel weight automatically from the order's products (createShippingPackage); otherwise a configurable fallback weight is used.",
        "silvershop/store-profile": "Central shop identity + sender address, shared with the shipping-labels packing slip."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\ShippingMyParcel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\ShippingMyParcel\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "lint": "phpcs src/ tests/",
        "test": "phpunit"
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
